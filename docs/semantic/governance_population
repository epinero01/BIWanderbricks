CREATE OR REPLACE VIEW wanderbricks_govern.ai_context AS

SELECT
    'BUSINESS_TERM' AS context_type,
    term_name AS object_name,
    business_definition AS context
FROM wanderbricks_govern.business_terms

UNION ALL

SELECT
    'METRIC',
    metric_name,
    business_definition
FROM wanderbricks_govern.metrics

UNION ALL

SELECT
    'RULE',
    rule_name,
    rule_description
FROM wanderbricks_govern.business_rules

UNION ALL

SELECT
    context_type,
    object_name,
    prompt_text
FROM wanderbricks_govern.prompt_context;

CREATE TABLE IF NOT EXISTS wanderbricks_govern.prompt_context (
    context_type STRING NOT NULL,

    object_name STRING NOT NULL,

    prompt_text STRING,

    active BOOLEAN,

    created_at TIMESTAMP,
    updated_at TIMESTAMP
);
